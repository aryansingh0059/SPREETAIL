# ==========================================
# SPREETAIL SPLIT - Environment Variables
# ==========================================

# 1. Database Connection URL
# Replace this with your production database URL (e.g. Supabase, Render, AWS RDS)
DATABASE_URL="postgresql://user:password@localhost:5432/spreetail?schema=public"

# 2. JWT Secret for Authentication
# Generate a strong random string for production
JWT_SECRET="your-super-secret-jwt-key"

# 3. Application Port (Optional, defaults to 4000)
PORT=4000
